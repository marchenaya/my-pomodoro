<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Entire Foreground Group scaled and moved down to avoid cropping -->
    <group
        android:translateX="0"
        android:translateY="-7"
        android:scaleX="0.88"
        android:scaleY="0.88"
        android:pivotX="54"
        android:pivotY="54">

        <!-- Tomato Body with Shadow -->
        <path
            android:pathData="M54,88c-15,0 -27,-12 -27,-27s12,-27 27,-27s27,12 27,27s-12,27 -27,27z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="54"
                    android:centerY="54"
                    android:gradientRadius="35"
                    android:type="radial">
                    <item android:offset="0" android:color="#FF5252"/>
                    <item android:offset="0.8" android:color="#EA3E33"/>
                    <item android:offset="1" android:color="#C62828"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Tomato Gloss/Light -->
        <path
            android:fillColor="#15FFFFFF"
            android:pathData="M54,39c-10,0 -18,6 -18,14c0,2 8,-3 18,-3s18,5 18,3c0,-8 -8,-14 -18,-14z" />

        <!-- Leaves (Realistic circular arrangement in 3/4 perspective) -->
        <group android:name="all_leaves"
            android:translateX="54"
            android:translateY="40"
            android:scaleX="1.1"
            android:scaleY="0.5"
            android:rotation="0">

            <!-- Stem -->
            <path
                android:fillColor="#388E3C"
                android:pathData="M0,0c0,-2 2,-4 2,-6c0,-2 -2,-4 -2,-4c0,0 -1,2 -1,4c0,2 1,4 1,6z" />

            <!-- Leaf 1 (Top) -->
            <group android:rotation="0">
                <path
                    android:fillColor="#81C784"
                    android:pathData="M0,0c-4,0 -5,-12 0,-18c5,6 4,18 0,18z" />
                <path
                    android:fillColor="#4CAF50"
                    android:pathData="M0,0c0,0 3,-18 0,-18c0,0 2.5,18 0,18z" />
            </group>

            <!-- Leaf 2 -->
            <group android:rotation="60">
                <path
                    android:fillColor="#81C784"
                    android:pathData="M0,0c-4,0 -5,-12 0,-18c5,6 4,18 0,18z" />
                <path
                    android:fillColor="#4CAF50"
                    android:pathData="M0,0c0,0 3,-18 0,-18c0,0 2.5,18 0,18z" />
            </group>

            <!-- Leaf 3 -->
            <group android:rotation="120">
                <path
                    android:fillColor="#81C784"
                    android:pathData="M0,0c-4,0 -5,-12 0,-18c5,6 4,18 0,18z" />
                <path
                    android:fillColor="#4CAF50"
                    android:pathData="M0,0c0,0 3,-18 0,-18c0,0 2.5,18 0,18z" />
            </group>

            <!-- Leaf 4 -->
            <group android:rotation="180">
                <path
                    android:fillColor="#81C784"
                    android:pathData="M0,0c-4,0 -5,-12 0,-18c5,6 4,18 0,18z" />
                <path
                    android:fillColor="#4CAF50"
                    android:pathData="M0,0c0,0 3,-18 0,-18c0,0 2.5,18 0,18z" />
            </group>

            <!-- Leaf 5 -->
            <group android:rotation="240">
                <path
                    android:fillColor="#81C784"
                    android:pathData="M0,0c-4,0 -5,-12 0,-18c5,6 4,18 0,18z" />
                <path
                    android:fillColor="#4CAF50"
                    android:pathData="M0,0c0,0 3,-18 0,-18c0,0 2.5,18 0,18z" />
            </group>

            <!-- Leaf 6 -->
            <group android:rotation="300">
                <path
                    android:fillColor="#81C784"
                    android:pathData="M0,0c-4,0 -5,-12 0,-18c5,6 4,18 0,18z" />
                <path
                    android:fillColor="#4CAF50"
                    android:pathData="M0,0c0,0 3,-18 0,-18c0,0 2.5,18 0,18z" />
            </group>
        </group>

        <!-- Clock Hands -->
        <!-- Hour Hand (Shorter) -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:pathData="M54,61 L46,55" />

        <!-- Minute Hand (Longer) -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:pathData="M54,61 L68,50" />

        <!-- Center Dot -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,61m-2.8,0a2.8,2.8 0,1 1,5.6 0a2.8,2.8 0,1 1,-5.6 0" />

    </group>

</vector>
